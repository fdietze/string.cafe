#!/usr/bin/env bash
set -Eeuo pipefail

source "$(dirname "$0")/db-common.sh"

cleanup() {
  rm -f "${PLAN_FILE:-}"

  if [ -n "${TARGET_DB:-}" ] && postgres_is_ready && database_exists "$TARGET_DB"; then
    dropdb "$TARGET_DB"
  fi

  stop_temp_postgres_if_started
}

run_postgres_server() {
  init_db_cluster
  ensure_layout

  postgres \
    -D "$PGDATA" \
    -k "$PGSOCKETDIR" \
    -p "$PGPORT" \
    -c listen_addresses='127.0.0.1' \
    -c unix_socket_directories="$PGSOCKETDIR" \
    -c "log_min_duration_statement=$PGLOG_MIN_DURATION_MS" \
    -c log_line_prefix='%m [%p] ' \
    &

  local server_pid=$!

  shutdown_server() {
    if kill -0 "$server_pid" 2>/dev/null; then
      kill "$server_pid"
      wait "$server_pid" || true
    fi
  }

  trap shutdown_server EXIT INT TERM

  wait_for_postgres
  ensure_database_exists "$PGDATABASE"

  wait "$server_pid"
}

apply_schema_to_named_database() {
  local db_name="$1"

  PGDATABASE="$db_name" pgschema apply \
    --file "$REPO_ROOT/schema.sql" \
    --auto-approve
}

apply_migrations_to_named_database() {
  local db_name="$1"
  local migration_file

  shopt -s nullglob

  for migration_file in "$REPO_ROOT"/migrations/*.sql; do
    printf 'Applying migration %s\n' "$(basename "$migration_file")"
    psql \
      --dbname="$db_name" \
      --set=ON_ERROR_STOP=1 \
      --file="$migration_file"
  done
}

cmd_init() {
  init_db_cluster
  printf 'Initialized Postgres data directory at %s\n' "$PGDATA"
}

cmd_run() {
  run_postgres_server
}

cmd_wait() {
  wait_for_postgres
  printf 'Postgres is ready on %s:%s\n' "$PGHOST" "$PGPORT"
}

cmd_psql() {
  trap cleanup EXIT

  start_temp_postgres_if_needed
  ensure_database_exists "$PGDATABASE"

  psql "$DATABASE_URL"
}

cmd_reset() {
  trap cleanup EXIT

  start_temp_postgres_if_needed
  recreate_database "$PGDATABASE"
  apply_schema_to_named_database "$PGDATABASE"

  printf 'Reset %s from schema.sql\n' "$PGDATABASE"
}

cmd_reset_from_migrations() {
  trap cleanup EXIT

  start_temp_postgres_if_needed
  recreate_database "$PGDATABASE"
  apply_migrations_to_named_database "$PGDATABASE"

  printf 'Reset %s from migrations\n' "$PGDATABASE"
}

cmd_check_migrations() {
  trap cleanup EXIT

  start_temp_postgres_if_needed

  TARGET_DB="$(make_temp_database_name)"
  PLAN_FILE="$(mktemp)"

  createdb "$TARGET_DB"
  apply_migrations_to_named_database "$TARGET_DB"

  PGDATABASE="$TARGET_DB" pgschema plan \
    --file "$REPO_ROOT/schema.sql" \
    --output-sql "$PLAN_FILE" \
    --no-color

  if [ -s "$PLAN_FILE" ]; then
    printf >&2 'Migrations and schema.sql have diverged:\n'
    cat "$PLAN_FILE" >&2
    exit 1
  fi

  printf 'Migrations reproduce schema.sql.\n'
}

cmd_generate_migration() {
  if [ "$#" -eq 0 ]; then
    printf >&2 'Usage: db-generate-migration <migration-name>\n'
    exit 1
  fi

  local raw_name="$1"
  local migration_name
  local timestamp
  local migration_file

  migration_name="$(slugify_migration_name "$raw_name")"

  if [ -z "$migration_name" ]; then
    printf >&2 'Migration name %s collapsed into nothing. Pick a better name.\n' "$raw_name"
    exit 1
  fi

  trap cleanup EXIT

  start_temp_postgres_if_needed

  TARGET_DB="$(make_temp_database_name)"
  PLAN_FILE="$(mktemp)"
  timestamp="$(date -u +%Y%m%d%H%M%S)"
  migration_file="$REPO_ROOT/migrations/${timestamp}_${migration_name}.sql"

  createdb "$TARGET_DB"
  apply_migrations_to_named_database "$TARGET_DB"

  PGDATABASE="$TARGET_DB" pgschema plan \
    --file "$REPO_ROOT/schema.sql" \
    --output-sql "$PLAN_FILE" \
    --no-color

  if [ ! -s "$PLAN_FILE" ]; then
    printf 'No schema changes detected. schema.sql and migrations are already aligned.\n'
    exit 0
  fi

  cp "$PLAN_FILE" "$migration_file"
  printf 'Created %s\n' "$migration_file"
}

cmd_wipe() {
  if postgres_is_ready; then
    printf >&2 'Refusing to wipe %s while Postgres is still running on %s:%s.\n' "$PGDATA" "$PGHOST" "$PGPORT"
    exit 1
  fi

  rm -rf "$REPO_ROOT/.local/postgres"
  printf 'Removed %s\n' "$REPO_ROOT/.local/postgres"
}

main() {
  if [ "$#" -eq 0 ]; then
    printf >&2 'Usage: db <subcommand> [args...]\n'
    exit 1
  fi

  local subcommand="$1"
  shift

  case "$subcommand" in
    init)
      cmd_init "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    wait)
      cmd_wait "$@"
      ;;
    psql)
      cmd_psql "$@"
      ;;
    reset)
      cmd_reset "$@"
      ;;
    reset-from-migrations)
      cmd_reset_from_migrations "$@"
      ;;
    check-migrations)
      cmd_check_migrations "$@"
      ;;
    generate-migration)
      cmd_generate_migration "$@"
      ;;
    wipe)
      cmd_wipe "$@"
      ;;
    *)
      printf >&2 'Unknown db subcommand: %s\n' "$subcommand"
      exit 1
      ;;
  esac
}

main "$@"
